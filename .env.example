# ==============================================================================
# Kalaivani Sainik Academy — Production Environment Configuration Template
# Copy this file to .env.local for local development or set in your production host
# ==============================================================================

# Application Runtime & Domain
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://kalaivanisainikcoachingcentre.org.in

# Domain & Automated SSL (Used by Caddy reverse proxy)
DOMAIN_NAME=kalaivanisainikcoachingcentre.org.in
ACME_EMAIL=admissions@kalaivanisainikcoachingcentre.org.in

# Authentication & Session Security (REQUIRED IN PRODUCTION)
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_a_secure_random_32_byte_secret_key_here

# Initial Database Bootstrap Admin Password
# Used only on first database initialization if no admin exists
ADMIN_INITIAL_PASSWORD=SetAStrongPassword2026!

# Telephony Integration & Webhook Security
# Shared secret with your telephony provider (e.g., Exotel, Twilio, Knowlarity)
TELEPHONY_WEBHOOK_SECRET=replace_with_your_telephony_webhook_hmac_secret

# Real-Time Lead Notifications
# 1. Instant Webhook (Discord, Slack, WhatsApp Cloud API, Zapier, Make)
LEAD_NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# 2. Email Notification Hook (Optional: Resend API)
RESEND_API_KEY=re_123456789
ADMISSIONS_ALERT_EMAIL=admissions@kalaivanisainikcoachingcentre.org.in
